# Copy this file to .env and fill in your key. Never commit .env.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openai/gpt-oss-120b

# Pin ONE hosting provider so every experiment runs on the same backend.
# Pick a provider slug from the model's page on openrouter.ai (Providers tab).
# Leave empty only while testing.
LLM_PROVIDER=

# Optional: reasoning effort for gpt-oss (low / medium / high). Keep it fixed for all runs.
LLM_REASONING_EFFORT=medium
